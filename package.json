{
  "name": "sky-report",
  "version": "0.1.0",
  "private": true,
  "description": "Type an airport code; see the real current sky, ray-marched from the live weather report.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:smoke",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:smoke": "node --test \"tests/smoke/*.test.mjs\"",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run build && wrangler dev",
    "shots": "node scripts/shots.mjs",
    "calibrate": "node scripts/calibrate-cover.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
